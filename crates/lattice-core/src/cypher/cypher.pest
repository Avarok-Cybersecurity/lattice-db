// Cypher Query Language Grammar (read-query subset + CREATE / DELETE)
//
// Read queries: MATCH / OPTIONAL MATCH (each with its own WHERE), UNWIND, WITH ... WHERE,
// RETURN [DISTINCT] ... ORDER BY ... SKIP ... LIMIT.
//
// Every operator is a named rule so the parser sees it (an anonymous "-" would be dropped
// from the parse tree, silently turning `a - b` into `a + b`). Keywords end at a word
// boundary so `nullable`, `order_id` or `index` stay identifiers.

statement = _{ SOI ~ (query | create_statement | delete_statement) ~ ";"? ~ EOI }

// === Keywords ===

ident_char = _{ ASCII_ALPHANUMERIC | "_" }
kw_match = @{ ^"MATCH" ~ !ident_char }
kw_optional = @{ ^"OPTIONAL" ~ !ident_char }
kw_where = @{ ^"WHERE" ~ !ident_char }
kw_return = @{ ^"RETURN" ~ !ident_char }
kw_with = @{ ^"WITH" ~ !ident_char }
kw_unwind = @{ ^"UNWIND" ~ !ident_char }
kw_as = @{ ^"AS" ~ !ident_char }
kw_distinct = @{ ^"DISTINCT" ~ !ident_char }
kw_order = @{ ^"ORDER" ~ !ident_char }
kw_by = @{ ^"BY" ~ !ident_char }
kw_skip = @{ ^"SKIP" ~ !ident_char }
kw_limit = @{ ^"LIMIT" ~ !ident_char }
kw_create = @{ ^"CREATE" ~ !ident_char }
kw_delete = @{ ^"DELETE" ~ !ident_char }
kw_detach = @{ ^"DETACH" ~ !ident_char }
kw_or = @{ ^"OR" ~ !ident_char }
kw_xor = @{ ^"XOR" ~ !ident_char }
kw_and = @{ ^"AND" ~ !ident_char }
kw_not = @{ ^"NOT" ~ !ident_char }
kw_is = @{ ^"IS" ~ !ident_char }
kw_null = @{ ^"NULL" ~ !ident_char }
kw_in = @{ ^"IN" ~ !ident_char }
kw_starts = @{ ^"STARTS" ~ !ident_char }
kw_ends = @{ ^"ENDS" ~ !ident_char }
kw_contains = @{ ^"CONTAINS" ~ !ident_char }
kw_case = @{ ^"CASE" ~ !ident_char }
kw_when = @{ ^"WHEN" ~ !ident_char }
kw_then = @{ ^"THEN" ~ !ident_char }
kw_else = @{ ^"ELSE" ~ !ident_char }
kw_end = @{ ^"END" ~ !ident_char }

// === Query Structure ===

query = { reading_clause* ~ return_clause }
reading_clause = _{ match_clause | optional_match | unwind_clause | with_clause }

match_clause = { kw_match ~ pattern_list ~ where_clause? }
optional_match = { kw_optional ~ kw_match ~ pattern_list ~ where_clause? }
unwind_clause = { kw_unwind ~ expression ~ kw_as ~ identifier }
with_clause = { kw_with ~ projection_body ~ where_clause? }
where_clause = { kw_where ~ expression }
return_clause = { kw_return ~ projection_body }

projection_body = { distinct? ~ return_items ~ order_by_clause? ~ skip_clause? ~ limit_clause? }
distinct = { kw_distinct }
return_items = { return_item ~ ("," ~ return_item)* }
return_item = { star | (expression ~ alias?) }
star = { "*" }
alias = { kw_as ~ identifier }

order_by_clause = { kw_order ~ kw_by ~ order_item ~ ("," ~ order_item)* }
order_item = { expression ~ order_direction? }
order_direction = @{ (^"ASCENDING" | ^"ASC" | ^"DESCENDING" | ^"DESC") ~ !ident_char }

skip_clause = { kw_skip ~ integer }
limit_clause = { kw_limit ~ integer }

// === Create / Delete Statements ===

create_statement = { kw_create ~ pattern_list }

delete_statement = { detach? ~ kw_delete ~ variable_list }
detach = { kw_detach }
variable_list = { identifier ~ ("," ~ identifier)* }

// === Pattern Matching ===

pattern_list = { pattern ~ ("," ~ pattern)* }

pattern = { node_pattern ~ (relationship_pattern ~ node_pattern)* }

node_pattern = {
    "(" ~ identifier? ~ label_list? ~ properties? ~ ")"
}

relationship_pattern = {
    left_arrow? ~ dash ~ "[" ~ rel_detail? ~ "]" ~ dash ~ right_arrow?
  | left_arrow? ~ dash ~ dash ~ right_arrow?
}

rel_detail = { identifier? ~ rel_type_list? ~ path_length? ~ properties? }

left_arrow = { "<" }
right_arrow = { ">" }
dash = _{ "-" }

label_list = { (":" ~ identifier)+ }
rel_type_list = { (":" ~ identifier) ~ ("|" ~ ":"? ~ identifier)* }

path_length = { "*" ~ path_range? }
path_range = {
    integer ~ ".." ~ integer?
  | ".." ~ integer
  | integer
}

properties = { "{" ~ property_list? ~ "}" }
property_list = { property ~ ("," ~ property)* }
property = { identifier ~ ":" ~ expression }

// === Expressions (loosest binding first) ===

expression = { or_expr }

or_expr = { xor_expr ~ (kw_or ~ xor_expr)* }
xor_expr = { and_expr ~ (kw_xor ~ and_expr)* }
and_expr = { not_expr ~ (kw_and ~ not_expr)* }
not_expr = { kw_not* ~ comparison }

// a < b < c chains (openCypher: a < b AND b < c)
comparison = { predicate_expr ~ (comparison_op ~ predicate_expr)* }
comparison_op = { "=~" | "<>" | "!=" | "<=" | ">=" | "=" | "<" | ">" }

// String, list and null predicates bind tighter than comparisons
predicate_expr = { addition ~ predicate_tail* }
predicate_tail = _{
    is_not_null
  | is_null
  | starts_with ~ addition
  | ends_with ~ addition
  | contains_op ~ addition
  | in_op ~ addition
}
is_not_null = { kw_is ~ kw_not ~ kw_null }
is_null = { kw_is ~ kw_null }
starts_with = { kw_starts ~ kw_with }
ends_with = { kw_ends ~ kw_with }
contains_op = { kw_contains }
in_op = { kw_in }

addition = { multiplication ~ (add_op ~ multiplication)* }
add_op = { "+" | "-" }
multiplication = { power ~ (mul_op ~ power)* }
mul_op = { "*" | "/" | "%" }
power = { unary ~ ("^" ~ unary)* }
unary = { sign_op* ~ postfix }
sign_op = { "-" | "+" }

postfix = { atom ~ postfix_op* ~ label_list? }
postfix_op = _{ property_access | slice | index }
property_access = { "." ~ identifier }
slice = { "[" ~ slice_from? ~ ".." ~ slice_to? ~ "]" }
slice_from = { expression }
slice_to = { expression }
index = { "[" ~ expression ~ "]" }

atom = {
    literal
  | parameter
  | case_expr
  | function_call
  | list_literal
  | map_literal
  | "(" ~ expression ~ ")"
  | identifier
}

// === Literals ===

literal = { null_literal | boolean_literal | number_literal | string_literal }

null_literal = { kw_null }
boolean_literal = @{ (^"TRUE" | ^"FALSE") ~ !ident_char }

number_literal = { float | integer }
float = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+ ~ exponent? | exponent) }
integer = @{ ASCII_DIGIT+ ~ !ident_char }
exponent = @{ ("e"|"E") ~ ("+"|"-")? ~ ASCII_DIGIT+ }

string_literal = { single_quoted | double_quoted }
single_quoted = @{ "'" ~ ("\\" ~ ANY | !"'" ~ ANY)* ~ "'" }
double_quoted = @{ "\"" ~ ("\\" ~ ANY | !"\"" ~ ANY)* ~ "\"" }

list_literal = { "[" ~ (expression ~ ("," ~ expression)*)? ~ "]" }
map_literal = { "{" ~ (map_entry ~ ("," ~ map_entry)*)? ~ "}" }
map_entry = { identifier ~ ":" ~ expression }

// === Parameter ===

parameter = { "$" ~ identifier }

// === Function Calls ===

function_call = { function_name ~ "(" ~ (count_star | distinct? ~ (expression ~ ("," ~ expression)*)?) ~ ")" }
function_name = @{ (ASCII_ALPHA | "_") ~ ident_char* ~ ("." ~ (ASCII_ALPHA | "_") ~ ident_char*)* }
count_star = { "*" }

// === Case Expression ===

case_expr = { kw_case ~ case_operand? ~ when_clause+ ~ else_clause? ~ kw_end }
case_operand = { !kw_when ~ expression }
when_clause = { kw_when ~ expression ~ kw_then ~ expression }
else_clause = { kw_else ~ expression }

// === Identifiers ===

identifier = @{
    (ASCII_ALPHA | "_") ~ ident_char*
  | backtick_identifier
}
backtick_identifier = @{ "`" ~ (!"`" ~ ANY | "``")* ~ "`" }

// === Whitespace and Comments ===

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{
    "//" ~ (!"\n" ~ ANY)*
  | "/*" ~ (!"*/" ~ ANY)* ~ "*/"
}
